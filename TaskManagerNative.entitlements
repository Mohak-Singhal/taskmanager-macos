<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- This is a system utility: it must enumerate/terminate other processes,
         read IOKit statistics, and spawn helper tools (ps, nettop, lsof, ...).
         App Sandbox is intentionally DISABLED because it blocks all of those. -->
    <key>com.apple.security.device.disk-arbitration</key>
    <true/>
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
